flowchart TD
    START([Inicio del Worker]) --> CONFIG[Cargar configuración segura]
    CONFIG --> RUN[Registrar ejecución EN_PROCESO]
    RUN --> SPLIT{Extracción paralela}

    SPLIT --> CSV[Leer y validar encuestas CSV]
    SPLIT --> SQL[Consultar reseñas en SQL Server]
    SPLIT --> API[Consumir comentarios con HttpClient]

    CSV --> MERGE[Consolidar resultados]
    SQL --> MERGE
    API --> MERGE

    MERGE --> STAGING[Carga masiva en tablas staging]
    STAGING --> AUDIT[Registrar cantidades, duplicados y duración]
    AUDIT --> OK[Marcar ejecución COMPLETADA]
    OK --> END([Fin o próxima ejecución])

    CSV -. excepción .-> ERROR[ILogger: registrar error]
    SQL -. excepción .-> ERROR
    API -. excepción .-> ERROR
    STAGING -. excepción .-> ERROR
    ERROR --> FAIL[Marcar ejecución ERROR]
    FAIL --> END
